# Anthropic API key used for the LLM-driven discovery loop.
# Not needed for replay (replay never calls the LLM).
ANTHROPIC_API_KEY=

# Model used for the discovery agent loop.
ANTHROPIC_MODEL=claude-sonnet-5

# Set to "false" to run the browser headless. Defaults to visible so a human
# can see (and, on escalation, take over) the live session.
HEADED=true
